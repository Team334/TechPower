{
  "app": { "name": "TechPower", "version": "1.3.0" },

  "log_sources": {
    "wpilog": {
      "extensions": [".wpilog"],
      "keys": {
        "battery_voltage":     "/Robot/SystemStats/BatteryVoltage",
        "battery_current":     "/Robot/SystemStats/PowerDistribution/TotalCurrent",
        "brownout":            "/Robot/SystemStats/BrownedOut",
        "enabled":             "DS:enabled",
        "autonomous":          "DS:autonomous",
        "pose":                "/Robot/Swerve/Pose",
        "chassis_speeds":      "/Robot/Swerve/Speeds",
        "auto_trajectory":     "/Robot/Auto/Current Trajectory"
      }
    },

    "hoot": {
      "extensions": [".wpilog"],
      "comment": "Hoot logs are wpilog files distinguished by their filename prefix after the match segment (01 = subsystems CANivore, CC = swerve CANivore).",
      "prefix_map": {
        "01": "subsystems",
        "CC": "swerve"
      },
      "signal_keys": {
        "stator_current": "StatorCurrent",
        "supply_current": "SupplyCurrent",
        "motor_voltage":  "MotorVoltage",
        "supply_voltage": "SupplyVoltage",
        "temperature":    "DeviceTemp"
      }
    }
  },

  "motors": [
    { "id": "fl_drive",  "name": "FL Drive",         "channel": 3,  "subsystem_id": "swerve",     "hoot_bus": "swerve",     "talon_id": 1 },
    { "id": "fl_steer",  "name": "FL Steer",          "channel": 4,  "subsystem_id": "swerve",     "hoot_bus": "swerve",     "talon_id": 2 },
    { "id": "fr_drive",  "name": "FR Drive",          "channel": 6,  "subsystem_id": "swerve",     "hoot_bus": "swerve",     "talon_id": 3 },
    { "id": "fr_steer",  "name": "FR Steer",          "channel": 7,  "subsystem_id": "swerve",     "hoot_bus": "swerve",     "talon_id": 4 },
    { "id": "bl_drive",  "name": "BL Drive",          "channel": 11, "subsystem_id": "swerve",     "hoot_bus": "swerve",     "talon_id": 5 },
    { "id": "bl_steer",  "name": "BL Steer",          "channel": 8,  "subsystem_id": "swerve",     "hoot_bus": "swerve",     "talon_id": 6 },
    { "id": "br_drive",  "name": "BR Drive",          "channel": 15, "subsystem_id": "swerve",     "hoot_bus": "swerve",     "talon_id": 7 },
    { "id": "br_steer",  "name": "BR Steer",          "channel": 9,  "subsystem_id": "swerve",     "hoot_bus": "swerve",     "talon_id": 8 },
    { "id": "shooter",   "name": "Shooter Flywheel",  "channel": 20, "subsystem_id": "subsystems", "hoot_bus": "subsystems", "talon_id": 1 },
    { "id": "shooter2",  "name": "Shooter Follower",  "channel": null,"subsystem_id": "subsystems", "hoot_bus": "subsystems", "talon_id": 2 },
    { "id": "hopper_r",  "name": "Hopper Roller",     "channel": 21, "subsystem_id": "subsystems", "hoot_bus": "subsystems", "talon_id": 3 },
    { "id": "hopper_f",  "name": "Hopper Floor",      "channel": 22, "subsystem_id": "subsystems", "hoot_bus": "subsystems", "talon_id": 4 },
    { "id": "intake_p",  "name": "Intake Pivot",      "channel": null,"subsystem_id": "subsystems", "hoot_bus": "subsystems", "talon_id": 5 },
    { "id": "intake_f",  "name": "Intake Feed",       "channel": null,"subsystem_id": "subsystems", "hoot_bus": "subsystems", "talon_id": 6 },
    { "id": "climb",     "name": "Climb",             "channel": 23, "subsystem_id": "subsystems", "hoot_bus": "subsystems", "talon_id": 7, "optional": true }
  ],

  "subsystems": [
    { "id": "swerve",     "name": "Swerve Drivetrain",     "color": "#3b82f6" },
    { "id": "subsystems", "name": "Subsystems (CANivore)", "color": "#f97316" }
  ],

  "field": {
    "comment": "2026 field image from AdvantageScope (see static/img/FIELD_LICENSE.txt). Pixel corners are for the shipped image; blue_wall is the image side where x = 0.",
    "image": "img/field-2026.webp",
    "image_size": [1800, 731],
    "top_left": [241.7, 43.8],
    "bottom_right": [1558.3, 686.9],
    "length_m": 16.541,
    "width_m": 8.069,
    "blue_wall": "right",
    "robot_size_m": [0.85, 0.85]
  },

  "thresholds": {
    "sag_voltage": 8.0,
    "breaker_amps": 40
  },

  "energy_calculation": {
    "wh_conversion": 3600
  },

  "timeline": {
    "resample_hz": 50
  },

  "example_logs": {
